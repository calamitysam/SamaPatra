{
  "name": "samapatra-backend",
  "version": "1.0.0",
  "description": "SamaPatra backend - Inclusive exam platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "db:migrate": "node --loader tsx src/db/migrate.ts",
    "test": "vitest"
  },
  "keywords": [
    "education",
    "accessibility",
    "exams"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^9.0.1",
    "@google/generative-ai": "^0.21.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
