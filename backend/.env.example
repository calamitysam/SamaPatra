# Environment variables for SamaPatra backend

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432/samapatra
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samapatra
DB_USER=postgres
DB_PASSWORD=

# AI providers
# These are the starting values. An admin can change keys, models and providers
# from the admin panel; saved values there win over these.
# Which AI does what: sarvam or gemini
AI_TEXT_PROVIDER=sarvam
AI_PDF_PROVIDER=gemini

# Sarvam AI
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m
# Optional backup model used when the main one is busy (leave empty for none)
SARVAM_FALLBACK_MODEL=
# SARVAM_BASE_URL=https://api.sarvam.ai/v1

# Google Gemini (best for reading question paper PDFs)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash
GOOGLE_AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Encrypts API keys saved from the admin panel. Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Security
# Admin recovery code: used in the admin panel's "Forgot password" screen to get a new
# random admin password (the first time, it creates the admin). Keep it secret.
ADMIN_RECOVERY_CODE=
# Comma-separated list of allowed browser origins, e.g. your admin panel's Vercel URL:
# CORS_ORIGIN=https://samapatra-admin.vercel.app
# Set to true when the server runs behind a proxy/load balancer (most hosts)
TRUST_PROXY=false
JWT_SECRET=change_this_in_production
SESSION_SECRET=change_this_in_production

# Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=60
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_DELAY_MS=1000

# Cache
ENABLE_AI_CACHE=true
CACHE_TTL_HOURS=24

# Logging
LOG_LEVEL=info

JWT_SECRET=
TEACHER_SIGNUP_CODE=    
